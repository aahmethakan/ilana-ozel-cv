# Include this fragment from nginx's http {} context. TLS certificate paths
# remain deployment-specific and must be configured outside this example.
limit_req_zone $binary_remote_addr zone=api:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=upload:10m rate=6r/m;
limit_req_zone $binary_remote_addr zone=rewrite:10m rate=10r/m;

server {
    listen 80;
    server_name example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name example.com;
    # ssl_certificate /path/to/fullchain.pem;
    # ssl_certificate_key /path/to/privkey.pem;

    # App upload cap is 10 MiB by default; leave transport headroom only.
    client_max_body_size 12m;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # The upstream is a single loopback Uvicorn process. This app has no
    # WebSocket contract, so upgrade headers are intentionally omitted.
    location = /api/v1/cv/analyze {
        limit_req zone=upload burst=3 nodelay;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_pass http://127.0.0.1:8000;
    }

    location ~ ^/api/v1/cv/generate/.*/rewrite$ {
        limit_req zone=rewrite burst=3 nodelay;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_pass http://127.0.0.1:8000;
    }

    location / {
        limit_req zone=api burst=20 nodelay;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_pass http://127.0.0.1:8000;
    }
}
